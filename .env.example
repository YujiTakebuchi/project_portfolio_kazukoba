# =============================================================
# EmailJS（CONTACT フォームの送信）
# =============================================================
#
# このファイルをコピーして .env を作り、EmailJS の管理画面の値を入れる。
#   cp .env.example .env
#
# .env は .gitignore 済み（コミットされない）。
#
# 静的書き出し（adapter-static）でサーバーを持たないため、送信は
# ブラウザから EmailJS を直接叩く。ブラウザに渡る値なので SvelteKit の
# 決まりどおり PUBLIC_ を付ける（ビルド後の JS に埋め込まれる）。
#
# ここに入れるのは Account > General の「Public Key」。
# 「Private Key」はサーバー専用で、ブラウザからは使えない
# （埋め込んだ時点で秘密ではなくなる）。悪用を防ぐには EmailJS の
# Account > Security で以下を設定する。
#   - Allowed origins  : 公開先のドメインだけを許可する
#   - reCAPTCHA / rate limit : 必要に応じて有効にする

# Email Services の Service ID
PUBLIC_EMAILJS_SERVICE_ID=

# Email Templates の Template ID
PUBLIC_EMAILJS_TEMPLATE_ID=

# Account > General の Public Key
PUBLIC_EMAILJS_PUBLIC_KEY=
